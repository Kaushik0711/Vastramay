# ==============================================================================
# ROSE ORCHID ATELIER: ENVIRONMENT VARIABLES & SECURITY SPECIFICATION
# ==============================================================================
# Copy this file to .env and fill in required keys. Never commit .env to Git!
# All variables prefixed with VITE_ are exposed to the client bundle.
# All secret keys (without VITE_) MUST ONLY reside on secure servers or Supabase Edge Functions.

# --- CLIENT ACCESSIBLE CONFIGURATION ---
# Base API endpoint for headless commerce services
VITE_API_BASE_URL=http://localhost:3000/api

# Google Analytics 4 Measurement ID
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Razorpay Public Key ID (Safe for client bundle; used to initialize client SDK)
# For sandbox testing, get test keys from https://dashboard.razorpay.com/
VITE_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXX

# Supabase Public Anonymous Key & Project URL (Safe for client bundle)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# --- SERVER-ONLY CONFIGURATION (NEVER EXPOSE TO VITE/BROWSER) ---
# Razorpay Private Secret Key (Used exclusively in serverless Edge Functions for order creation)
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here

# Razorpay Webhook Secret (Used to verify HMAC-SHA256 signatures of webhook events)
RAZORPAY_WEBHOOK_SECRET=your_webhook_signing_secret_here

# Supabase Service Role Key (Bypasses Row Level Security; server functions only)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
